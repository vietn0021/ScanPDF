SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Required only by npm run setup. Use the Supabase direct or session-pooler URI.
SUPABASE_DB_URL=
HOST=127.0.0.1
PORT=3000
# Only enable behind exactly one trusted reverse proxy. Leave empty for a direct connection.
TRUST_PROXY=1
MAX_HEAVY=2
MAX_DOCUMENTS_PER_OWNER=200
MAX_BYTES_PER_OWNER=209715200
# Optional. If set, add this URL to Supabase Auth's allowed redirect URLs.
SUPABASE_EMAIL_REDIRECT_URL=

# Optional, only for npm run test:integration on a development project.
# SCANPDF_RUN_INTEGRATION=1
# SCANPDF_TEST_EMAIL_A=
# SCANPDF_TEST_PASSWORD_A=
# SCANPDF_TEST_EMAIL_B=
# SCANPDF_TEST_PASSWORD_B=
